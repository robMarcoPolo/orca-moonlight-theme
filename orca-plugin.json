{
  "manifestVersion": 2,
  "id": "moonlight-theme",
  "name": "Moonlight for Orca",
  "version": "1.0.0",
  "execution": "data",
  "description": "Unofficial port of atomiks’ Moonlight II: a bubblegum-on-moonlit-navy dark theme (plus an italic variant) with matching code and terminal colors.",
  "license": "MIT",
  "repository": "https://github.com/robMarcoPolo/orca-moonlight-theme",
  "homepage": "https://github.com/robMarcoPolo/orca-moonlight-theme",
  "engines": {
    "orca": ">=1.4.246"
  },
  "contributes": {
    "themes": [
      {
        "id": "moonlight-ii",
        "title": "Moonlight II",
        "path": "themes/moonlight-ii.json"
      },
      {
        "id": "moonlight-ii-italic",
        "title": "Moonlight II Italic",
        "path": "themes/moonlight-ii-italic.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "moonlight-ii",
        "title": "Moonlight II",
        "path": "terminal/moonlight-ii.json"
      }
    ]
  },
  "capabilities": []
}
